{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "../dist/schematics"
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.spec.ts"]
}
