{
  "name": "ng-typed-routes-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for ng-typed-routes: type-safe routing for Angular, generated from your routes file.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build -w ng-typed-routes",
    "test": "npm run test -w ng-typed-routes",
    "lint": "eslint .",
    "demo:generate": "npm run routes:generate -w demo-app",
    "demo:check": "npm run routes:check -w demo-app",
    "demo:build": "npm run build -w demo-app",
    "demo:verify-type-errors": "node scripts/verify-template-errors.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular-devkit/schematics": "^22.2.4",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
